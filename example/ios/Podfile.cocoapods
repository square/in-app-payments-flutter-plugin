# Podfile for the CocoaPods regression build only.
#
# The example app integrates iOS through Swift Package Manager, so there is no
# Podfile checked in at `example/ios/Podfile` on purpose: `pod install` rewrites
# `Runner.xcodeproj`, and a Podfile sitting there would make every SPM build
# mutate the tracked project file. The `build-ios-cocoapods` CI job copies this
# file into place before building. To reproduce locally:
#
#   cd example/ios && cp Podfile.cocoapods Podfile
#   cd .. && flutter config --no-enable-swift-package-manager && flutter build ios --no-codesign
#
# `pod install` rewrites Runner.xcodeproj (it adds the [CP] build phases and the
# Pods-Runner xcconfig references), so after reproducing locally, reset the
# project file and drop the generated files before going back to SPM:
#
#   rm -rf example/ios/Podfile example/ios/Podfile.lock example/ios/Pods
#   git checkout -- example/ios/Runner.xcodeproj/project.pbxproj \
#                   example/ios/Flutter/Debug.xcconfig \
#                   example/ios/Flutter/Release.xcconfig \
#                   example/ios/Runner.xcworkspace/contents.xcworkspacedata
#   flutter config --enable-swift-package-manager

platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

$sqipVersion = '1.6.7'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Deliberately no `use_frameworks!`: the pod is mixed Objective-C/Swift but builds
  # as a static library with modules enabled (DEFINES_MODULE in the podspec), so this
  # matches the default Podfile a consumer app would have.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
